{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dispatch SFTP",
  "version": "1.2.5",
  "identifier": "com.laki.dispatch",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Dispatch - SFTP Client",
        "width": 1320,
        "height": 840,
        "minWidth": 640,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 17
        },
        "backgroundColor": "#101010"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "files": {
        "Resources/Assets.car": "icons/Assets.car"
      }
    },
    "resources": {
      "../LICENSE": "LICENSE",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc0RTczMzVDQTk5MUQ0MkQKUldRdDFKR3BYRFBuZEYyMlJiRnpRNFdJVmFlYVpJYllMSkFOQ0tBbTNlYWw1cjU3ZE9Ed3VrSkcK",
      "endpoints": [
        "https://github.com/lakiAlex/dispatch/releases/latest/download/latest.json"
      ]
    }
  }
}
